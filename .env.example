# ==============================================================================
# Student Community Platform - Production Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# App Secrets & URLs
APP_KEY=generate_secure_random_key_here_32_chars
APP_URL=https://your-domain.com

# Session Configuration
SESSION_DRIVER=cookie

# Database Configuration (Supabase PostgreSQL / Self-Hosted PostgreSQL)
DB_CONNECTION=pg
DB_HOST=db.leowjdfbufhnbgkttxrg.supabase.co
DB_PORT=6543
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_DATABASE=postgres
# DB_URL=postgresql://postgres:password@host:6543/postgres?pgbouncer=true

# Security & CORS
CORS_ORIGIN=https://your-domain.com,http://localhost:5173

# Redis Integration (Optional for multi-node Socket.io scaling)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Frontend Environment Variables (Vite)
VITE_API_URL=https://your-domain.com/api/v1
VITE_WS_URL=https://your-domain.com
